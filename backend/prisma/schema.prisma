// This is the Prisma schema file for EventFlow.
// It defines the database tables, relations, and generators.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Role enum restricts user types to three fixed options in the system.
// - STUDENT: Can view events and register for them.
// - ORGANIZER: Can create and manage their own events.
// - ADMIN: Can manage all users, organizers, and events across the college.
enum Role {
  STUDENT
  ORGANIZER
  ADMIN
}

// EventStatus enum tracks the lifecycle of an event.
// - DRAFT: Created by organizer but not yet visible to students.
// - PUBLISHED: Live and open for students to view and register.
// - CANCELLED: Event was called off by the organizer or college.
// - COMPLETED: Event has taken place and ended.
enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

// RegistrationStatus enum tracks whether an enrollment is active or cancelled.
// - REGISTERED: Student is confirmed to attend the event.
// - CANCELLED: Student withdrew or organizer cancelled; status changes instead of deleting the row.
enum RegistrationStatus {
  REGISTERED
  CANCELLED
}

// User model represents college students, club organizers, and administrators.
model User {
  // Primary key using a universally unique identifier (UUID) to avoid ID collisions
  id            String         @id @default(uuid())

  // Full name of the user
  name          String

  // Unique email address used for logging in; @unique stops duplicate accounts
  email         String         @unique

  // Stores the bcrypt HASH of the user password (named "password" because Aman's controller uses it)
  password      String

  // Role assigned to the user; defaults to STUDENT for public registrations
  role          Role           @default(STUDENT)

  // One-to-many relation: one user (an organizer) can create multiple events
  events        Event[]

  // One-to-many relation: one student can register for multiple events
  registrations Registration[]

  // Timestamp when the account was first created in the database
  createdAt     DateTime       @default(now())

  // Timestamp automatically updated whenever the user record is modified
  updatedAt     DateTime       @updatedAt
}

// Event model represents college workshops, fests, hackathons, and competitions.
model Event {
  // Primary key using UUID for unique identification
  id                   String         @id @default(uuid())

  // Name or title of the event
  title                String

  // Detailed description of the event; @db.Text allows unlimited length text in PostgreSQL
  description          String         @db.Text

  // Physical location or hall on campus where the event will take place
  venue                String

  // Optional category grouping (e.g., Technical, Cultural, Sports, Workshops)
  category             String?

  // Optional URL pointing to the event banner or cover image
  imageUrl             String?

  // Start date and time of the event
  startDate            DateTime

  // End date and time of the event
  endDate              DateTime

  // Cut-off date and time after which registrations are closed
  registrationDeadline DateTime

  // Maximum number of participants who can attend
  capacity             Int

  // Current status of the event in its lifecycle; defaults to DRAFT
  status               EventStatus    @default(DRAFT)

  // Foreign key referencing the User who organized this event
  organizerId          String

  // Relational link to the User model; enables querying event organizer details
  organizer            User           @relation(fields: [organizerId], references: [id])

  // One-to-many relation: one event can have many student registrations
  registrations        Registration[]

  // Timestamp when the event was created in the database
  createdAt            DateTime       @default(now())

  // Timestamp automatically updated whenever event details change
  updatedAt            DateTime       @updatedAt
}

// Registration model acts as a junction table between Student (User) and Event.
// It stores attendance details, tickets, and verification tokens.
model Registration {
  // Primary key using UUID for unique registration ticket identification
  id           String             @id @default(uuid())

  // Foreign key referencing the student who registered
  studentId    String

  // Foreign key referencing the event being registered for
  eventId      String

  // Unique QR token generated per registration for fast on-campus scanning and ticket check-in
  qrToken      String             @unique @default(uuid())

  // Status of the registration; cancelling changes status instead of deleting the row to preserve history
  status       RegistrationStatus @default(REGISTERED)

  // Timestamp when the student submitted their registration
  registeredAt DateTime           @default(now())

  // Relational link to the student User record
  student      User               @relation(fields: [studentId], references: [id])

  // Relational link to the registered Event record
  event        Event              @relation(fields: [eventId], references: [id])

  // Compound unique constraint stops a student from registering twice for the same event
  @@unique([studentId, eventId])
}
